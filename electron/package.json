{
  "name": "word-tts-desktop",
  "version": "1.0.0",
  "description": "Word → TTS 一体化桌面工具",
  "main": "main.js",
  "author": "asklins223",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asklins223/word-tts-desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:python": "cd .. && pyinstaller server_pyinstaller.spec --noconfirm --distpath electron/server_backend_build --workpath electron/server_backend_build_tmp",
    "build": "npm run build:python && electron-builder",
    "build:mac": "npm run build:python && electron-builder --mac",
    "build:win": "npm run build:python && electron-builder --win"
  },
  "build": {
    "appId": "com.wordtts.desktop",
    "productName": "WordTTS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "server_backend_build/server_backend",
        "to": "server_backend",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.education",
      "icon": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "signIgnore": [
        "server_backend"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WordTTS",
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerHeaderIcon": null,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
