{
  "name": "word-tts-desktop",
  "version": "3.0.10",
  "description": "小猪wordTTS 文档配音桌面工具",
  "main": "main.js",
  "author": "asklins223",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asklins223/word-tts-desktop.git"
  },
  "scripts": {
    "start": "npm run version:sync && electron .",
    "dev": "npm run version:sync && electron . --dev",
    "test": "node --test test/*.test.js",
    "lint:contracts": "redocly lint ../contracts/openapi.yaml",
    "generate:contracts": "openapi-typescript ../contracts/openapi.yaml -o ../contracts/generated.ts",
    "check:generated": "node ../scripts/check_generated_contracts.js",
    "typecheck:contracts": "tsc --noEmit --target ES2022 --moduleResolution node --lib ES2022,DOM ../contracts/domain.ts ../contracts/generated.ts",
    "check:contracts": "npm run lint:contracts && npm run check:generated && npm run typecheck:contracts",
    "build:icons": "cd .. && node scripts/run_python.js scripts/build_app_icons.py",
    "build:python": "cd .. && node scripts/run_pyinstaller.js server_pyinstaller.spec --noconfirm --distpath electron/server_backend_build --workpath electron/server_backend_build_tmp && node scripts/stage_playwright_browser.js electron/server_backend_build/server_backend",
    "version:sync": "node ../scripts/project_version.js --sync",
    "build": "npm run version:sync && npm run build:icons && npm run build:python && electron-builder --publish never",
    "build:mac": "npm run version:sync && npm run build:icons && npm run build:python && electron-builder --mac --publish never",
    "build:win": "npm run version:sync && npm run build:icons && npm run build:python && electron-builder --win dir --publish never && node ../scripts/build_windows_installer.js --payload release/win-unpacked --output-dir release"
  },
  "build": {
    "appId": "com.wordtts.desktop",
    "productName": "小猪wordTTS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterSign": "notarize.js",
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB",
      "en_GB",
      "zh-CN",
      "zh_CN"
    ],
    "files": [
      "main.js",
      "file-dialogs.js",
      "update-manager.js",
      "windows-update-client.js",
      "workflow-api.js",
      "workflow-proxy.js",
      "source-staging.js",
      "workflow-event-transport.js",
      "workflow-artifact-transport.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "server_backend_build/server_backend",
        "to": "server_backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dir",
        "zip"
      ],
      "category": "public.app-category.education",
      "minimumSystemVersion": "12.0",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "publish": {
      "provider": "github",
      "owner": "asklins223",
      "repo": "word-tts-desktop",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@redocly/cli": "2.49.0",
    "css-select": "7.0.0",
    "css-tree": "3.2.1",
    "domutils": "4.0.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "htmlparser2": "12.0.0",
    "js-yaml": "4.3.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
